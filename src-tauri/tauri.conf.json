{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unnamed Desktop App",
  "version": "0.3.1",
  "identifier": "com.notlimited.unnameddesktopapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:app",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Unnamed Enhancements",
        "width": 1180,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
